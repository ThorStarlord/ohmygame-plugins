{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/openverse",
  "version": "0.1.0",
  "engines": {
    "ohmygame-api": "^2.5.0"
  },
  "displayName": "%plugin.name%",
  "description": "%plugin.description%",
  "longDescription": "%plugin.longDescription%",
  "icon": "./assets/icon.svg",
  "links": {
    "homepage": "https://openverse.org"
  },
  "categories": [
    "audio",
    "art"
  ],
  "beta": true,
  "entrypoints": {
    "native": "./native/index.mjs"
  },
  "capabilities": {
    "native": true,
    "secrets": true
  },
  "configuration": {
    "clientId": {
      "type": "text",
      "title": "%config.clientId.title%",
      "description": "%config.clientId.description%"
    },
    "clientSecret": {
      "type": "secret",
      "title": "%config.clientSecret.title%",
      "description": "%config.clientSecret.description%"
    }
  },
  "contributes": {
    "assetSources": [
      {
        "id": "openverse",
        "title": "%source.title%",
        "description": "%source.description%",
        "media": [
          "image",
          "audio"
        ],
        "search": "search",
        "fetch": "fetch",
        "timeoutSeconds": 120,
        "cacheSeconds": 3600,
        "collections": [
          {
            "id": "music",
            "title": "%collection.music%"
          },
          {
            "id": "sfx",
            "title": "%collection.sfx%"
          },
          {
            "id": "all",
            "title": "%collection.all%"
          }
        ]
      }
    ]
  }
}
