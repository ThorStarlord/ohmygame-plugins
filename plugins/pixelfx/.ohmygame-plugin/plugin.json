{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/pixelfx",
  "version": "0.1.0",
  "engines": {
    "ohmygame-api": "^2.38.0"
  },
  "displayName": "%displayName%",
  "description": "%description%",
  "longDescription": "%longDescription%",
  "examples": [
    "%example.1%",
    "%example.2%"
  ],
  "beta": true,
  "icon": "./assets/icon.svg",
  "categories": ["art"],
  "keywords": ["%keyword.effects%", "pixel art", "VFX", "sprite sheet"],
  "appliesTo": [
    "general",
    "web-game",
    "godot-game",
    "ohmygame/godot:godot-game"
  ],
  "activation": "project",
  "projectFiles": ["./pixelfx/"],
  "capabilities": {
    "project.files": "write",
    "library": true
  },
  "contributes": {
    "panels": [
      {
        "id": "studio",
        "title": "%panel.title%",
        "icon": "./assets/icon.svg",
        "area": "center",
        "entry": "./panel/index.html"
      }
    ]
  }
}
