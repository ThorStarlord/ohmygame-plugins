{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/game-icons",
  "version": "0.1.0",
  "engines": {
    "ohmygame-api": "^2.5.0"
  },
  "displayName": "%plugin.name%",
  "description": "%plugin.description%",
  "longDescription": "%plugin.longDescription%",
  "icon": "./assets/icon.svg",
  "links": {
    "homepage": "https://game-icons.net"
  },
  "categories": [
    "art"
  ],
  "beta": true,
  "entrypoints": {
    "native": "./native/index.mjs"
  },
  "capabilities": {
    "native": true
  },
  "contributes": {
    "assetSources": [
      {
        "id": "icons",
        "title": "%source.title%",
        "description": "%source.description%",
        "media": [
          "image"
        ],
        "search": "search",
        "fetch": "fetch",
        "collections": [
          {
            "id": "all",
            "title": "%collection.all%"
          },
          {
            "id": "weapon",
            "title": "%collection.weapon%"
          },
          {
            "id": "armor",
            "title": "%collection.armor%"
          },
          {
            "id": "creature",
            "title": "%collection.creature%"
          },
          {
            "id": "body",
            "title": "%collection.body%"
          },
          {
            "id": "magic",
            "title": "%collection.magic%"
          },
          {
            "id": "potion",
            "title": "%collection.potion%"
          },
          {
            "id": "food",
            "title": "%collection.food%"
          },
          {
            "id": "item",
            "title": "%collection.item%"
          },
          {
            "id": "nature",
            "title": "%collection.nature%"
          },
          {
            "id": "building",
            "title": "%collection.building%"
          },
          {
            "id": "symbol",
            "title": "%collection.symbol%"
          }
        ],
        "cacheSeconds": 86400
      }
    ]
  }
}
